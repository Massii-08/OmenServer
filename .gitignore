# Ignorer les fichiers sensibles et temporaires
.env
venv/
__pycache__/
*.pyc
data/
*.db
mdpdf.log
*.log
cloudflared
*.HEIC
*.jpg

# Yield Bot — fichiers runtime (pas du code)
yield-bot/bot/.rate_limit.json
yield-bot/uploads/

# Virtualenvs (Python) — n'importe quel sous-dossier
**/.venv/
**/venv/

# Node — jamais committé (piège #42h : un symlink node_modules absolu committé
# depuis un worktree a cassé tous les bots en prod, silencieusement).
# SANS slash final : avec « / » le pattern ne matche que les répertoires, et
# c'est justement un SYMLINK qui avait fui.
**/node_modules

# Système macOS
**/.DS_Store

# Ruflo / RuVector — fichiers locaux d'agents
agentdb.rvf
agentdb.rvf.lock
.ruflo/
.claude/
bond-scanner/bot/.rate_limit.json
market-pulse/out/
