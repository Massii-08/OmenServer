# OmenServer — Configuration
# Copie ce fichier en .env et remplis les valeurs

# Clé secrète pour signer les tokens JWT (génère une clé aléatoire !)
SECRET_KEY=change-moi-en-production-stp

# Nom du serveur (affiché dans le panel)
SERVER_NAME=OmenServer

# Durée de validité du token en minutes (1440 = 24h)
TOKEN_EXPIRE_MINUTES=1440

# Serveur
HOST=0.0.0.0
PORT=8000

# Docker — image Minecraft par défaut
MINECRAFT_IMAGE=itzg/minecraft-server

# CurseForge API — Obtiens ta clé sur https://console.curseforge.com/
CURSEFORGE_API_KEY=
